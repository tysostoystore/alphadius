---
import Layout from "@/layouts/Layout.astro";
import { AlphaTable } from "@/components/AlphaTable";
---

<Layout>
  <!-- Hero Section -->
  <div class="mb-8">
    <div class="flex items-end justify-between">
      <div>
        <h1 class="text-2xl font-bold text-zinc-100 flex items-center gap-3">
          <span
            class="inline-block w-1.5 h-8 rounded-full"
            style="background: linear-gradient(180deg, #a855f7, #c084fc)"
          ></span>
          <a
            href="https://audius.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-purple-500 hover:text-purple-400 underline decoration-purple-500/30 underline-offset-4 transition-colors"
            >Audius</a
          > Alpha Terminal
        </h1>
        <p class="text-sm text-zinc-400 mt-1 font-sans font-medium">
          Discover artists before they blow up.
          <span class="text-zinc-600 font-normal hidden sm:inline">
            &nbsp;·&nbsp; Ranked by Alpha — plays vs. followers, boosted by growth.
          </span>
        </p>
        <!-- Mobile-only: artist count + sync time (hidden sm+, those are in the header) -->
        <div class="flex sm:hidden items-center gap-2 mt-2 text-[10px] font-mono text-zinc-500">
          <span class="text-purple-400 font-bold" id="mobile-artist-count">—</span>
          <span>artists indexed</span>
          <span class="text-zinc-700">·</span>
          <span id="mobile-last-updated" class="text-zinc-600">loading...</span>
        </div>
      </div>
    </div>

    <div
      class="mt-4 h-[1px]"
      style="background: linear-gradient(90deg, #a855f7, transparent 100%)"
    >
    </div>
  </div>

  <!-- Main Dashboard -->
  <AlphaTable client:load />
</Layout>
